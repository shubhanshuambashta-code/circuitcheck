# Copy to .env. Values are literal; no shell expansion. Keep .env private.
KICAD_CLI=C:/Program Files/KiCad/10.0/bin/kicad-cli.exe
# Linux with KiCad on PATH: omit KICAD_CLI, or use /usr/bin/kicad-cli
ENGINE_TIMEOUT=120
# CIRCUITCHECK_DATA=/absolute/private/data/directory

# Optional OpenAI-compatible chat completions endpoint. Core checks need no key.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
